{
  "name": "video-meetings",
  "version": "0.1.0",
  "private": true,
  "description": "NPM-монорепозиторий: Next.js фронтенд и NestJS бэкенд",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "dev": "concurrently -n web,api -c green,cyan \"npm run dev:web\" \"npm run dev:api\"",
    "dev:web": "npm run dev --workspace @video-meetings/web",
    "dev:api": "npm run dev --workspace @video-meetings/api",
    "build:web": "npm run build --workspace @video-meetings/web",
    "build:api": "npm run build --workspace @video-meetings/api",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "rm -rf node_modules apps/*/node_modules apps/*/.next apps/*/dist",
    "prepare": "husky",
    "test": "npm run test --workspaces --if-present",
    "dev:clean": "kill $(lsof -ti:3000,3001) 2>/dev/null; npm run dev"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,json,css,md}": "prettier --write"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "concurrently": "^10.0.4",
    "eslint": "^9.13.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.8",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.11.0"
  },
  "engines": {
    "node": ">=18.18.0"
  }
}
