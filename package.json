{
  "name": "video-meetings",
  "version": "0.1.0",
  "private": true,
  "description": "NPM-монорепозиторий: Next.js фронтенд и NestJS бэкенд",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "dev": "npm run dev --workspaces --if-present",
    "dev:web": "npm run dev --workspace @video-meetings/web",
    "dev:api": "npm run dev --workspace @video-meetings/api",
    "build:web": "npm run build --workspace @video-meetings/web",
    "build:api": "npm run build --workspace @video-meetings/api",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "rm -rf node_modules apps/*/node_modules apps/*/.next apps/*/dist"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "eslint": "^9.13.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.11.0",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.8",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.11.0"
  },
  "engines": {
    "node": ">=18.18.0"
  }
}
